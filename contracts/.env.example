# Copy to .env (Foundry loads it automatically). Never commit .env files.
# Set the RPC for the target network and EXPECTED_CHAIN_ID before each deployment.
ETHEREUM_RPC_URL=
MONAD_MAINNET_RPC_URL=https://rpc.monad.xyz
MONAD_TESTNET_RPC_URL=https://testnet-rpc.monad.xyz
TEMPO_RPC_URL=https://rpc.tempo.xyz
TEMPO_TESTNET_RPC_URL=https://rpc.moderato.tempo.xyz
EXPECTED_CHAIN_ID=1             # change for each selected RPC

# ---- Deploy.s.sol
PRIVATE_KEY=
# ADMIN=0x...                  # Safe/multisig; initially defaults to deployer
# USDC=0x...                   # Required on production networks
# USDC_DECIMALS=6              # Optional assertion; actual decimals() is queried
# MORPHO=0x...
# IRM=0x...
LLTV=770000000000000000
DEPLOY_MOCK_USDC=false         # explicit opt-in; dev/test chain IDs only
DEPLOY_LOCAL_MORPHO=false      # explicit opt-in; isolated/test deployment only
# STABLE_FEED=0x...             # Chainlink-compatible stablecoin/USD feed, if available
# STABLE_FLOOR=98000000         # e.g. $0.98 for an 8-decimal feed
STABLE_MAX_STALENESS=86400
ALLOW_UNGUARDED_STABLE=false   # production must explicitly opt out if no stablecoin/USD feed exists
BASE_URI=https://tensile.app/lot/
RESERVE_MAX_STALENESS=86400

# ---- Onboard.s.sol
OPERATOR=
# WAREHOUSE_URI=ipfs://...
REGION=NG-LAGOS
WH_SIGNER=
INSP_SIGNER=
MATERIAL=REBAR-B500B-12MM
INITIAL_PRICE=60000000000      # $600.00 / tonne, 8 decimals
ROUTER_LTV_BPS=6500
MAX_ATTESTATION_AGE=2592000
# PRICE_UPDATER=0x...
